# aimee-server: the agent/memory broker. Owns DB1 (user-scoped SQLite store) and
# fronts the /v1 HTTP API; it reaches aimee-kb (DB2 + pgvector) over HTTP via
# AIMEE_KB_API_URL. Without that URL the kb-backed (shared/vector) features are
# simply unavailable, so this image also runs standalone (DB1-backed endpoints
# only). The legacy unix-socket kb transport + autostart were retired (#2747).
#
# WITH_RUNTIME_WEB bundles the browser UI (aimee-runtime-web). It is ON by default — the
# UI is a first-class surface. @rakuensoftware/smoothgui is vendored as a tarball
# under frontend/vendor/ (a file: dependency), so the frontend builds with NO
# registry token and NO credentials. Set --build-arg WITH_RUNTIME_WEB=0 to build the
# server-only image (skips the frontend + Go webchat stages entirely).
ARG WITH_RUNTIME_WEB=1
# WITH_VSCODE bundles code-server (full in-browser VSCode, Open-VSX only) for the
# webchat Projects/editor surface. ON by default — the editor is a first-class
# feature; build with --build-arg WITH_VSCODE=0 to omit it (saves ~100 MB).
ARG WITH_VSCODE=1

# The module runtime is a static multicall binary. The canonical process
# contracts decide which executable names are populated from it in the C build
# stage below, so Docker never carries a second language-selection list.
FROM golang:1.25-bookworm AS module-go-build
WORKDIR /src/server-go
COPY server-go/go.mod server-go/go.sum ./
RUN go mod download
COPY server-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/aimee-module ./cmd/aimee-module

FROM debian:bookworm-slim AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libpq-dev \
        libsqlite3-dev \
        libssl-dev \
        libzstd-dev \
        pkg-config \
        python3 \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
COPY --from=module-go-build /out/aimee-module /tmp/aimee-module-go
ARG AIMEE_VERSION=""
# The CLI ships alongside the server. It is what gives a spawned provider-CLI
# delegate (the `claude` binary) any access to aimee at all: `aimee mcp serve` is
# the stdio MCP proxy that forwards tool calls to this server over /v1, and
# `aimee hooks pre` is the PreToolUse guard. Without the binary in the image a
# delegate has no aimee tools and no guard can run — it gets a bare shell and its
# own credentials, which is the opposite of the intent.
RUN build_version="$AIMEE_VERSION" \
    && if [ -z "$build_version" ]; then build_version=$(cat src/core/VERSION); fi \
    && make -C src ../aimee-server ../aimee ../aimee-forwarder -j"$(nproc)" \
         GIT_VERSION="v$build_version"

# Build the independently supervised same-container module adapters from the
# canonical contract. C processes link only the extracted event-bus client;
# Go processes are copies of the static multicall runtime under attested names.
RUN python3 scripts/export_c_repositories.py --runtime-bundle /module-runtime \
    && mkdir -p /module-runtime/bin \
    && for source in /module-runtime/src/*.c; do \
         [ -e "$source" ] || continue; \
         binary="${source##*/}"; binary="${binary%.c}"; \
         cc -std=c11 -O2 -Wall -Wextra -Werror -Isrc/core/event_bus/include \
           -Isrc/modules/memory/include -Isrc/modules/learning/include \
           -Isrc/modules/routing/include -Isrc/modules/delegates/include \
           -Isrc/modules/tools/include -Isrc/modules/workspace/include \
           -Isrc/modules/git/include -Isrc/modules/skills/include \
           -Isrc/modules/response-composition/include \
           "$source" \
           src/core/event_bus/bus_attach.c src/core/event_bus/bus_client.c \
           src/core/event_bus/bus_endpoint.c src/core/event_bus/bus_region.c \
           src/core/event_bus/bus_ring.c src/core/event_bus/bus_wire.c \
           src/core/event_bus/module_protocol.c src/core/event_bus/module_runtime.c \
           -pthread \
           -o "/module-runtime/bin/$binary"; \
       done \
    && while IFS= read -r module_id; do \
         [ -n "$module_id" ] || continue; \
         install -m 0755 /tmp/aimee-module-go \
           "/module-runtime/bin/aimee-module-$module_id"; \
       done < /module-runtime/go.modules

# --- webchat frontend: build the React SPA into a single index.html ---
# vite-plugin-singlefile inlines all JS/CSS, so the runtime image ships one file.
FROM node:20-bookworm AS frontend-build
WORKDIR /frontend
# @rakuensoftware/smoothgui is vendored under frontend/vendor/ as a tarball and
# referenced via a file: dependency, so `npm ci` resolves it from the build
# context (no GitHub Packages token, no .npmrc, no BuildKit secret). The vendored
# tarball must be present before `npm ci` reads the lockfile.
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/vendor/ ./vendor/
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- webchat service: standalone Go browser server (cgo: legacy crypt migration + sqlite) ---
FROM golang:1.25-bookworm AS runtime-web-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libcrypt-dev \
        libpam0g-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/runtime-web
COPY server-go/go.mod server-go/go.sum /src/server-go/
COPY server-go/modules/runtime-web/policy/ /src/server-go/modules/runtime-web/policy/
COPY runtime-web/go.mod runtime-web/go.sum ./
RUN go mod download
COPY runtime-web/ ./
RUN CGO_ENABLED=1 go build -o /out/aimee-runtime-web .

# Go owns the WFE control plane. It is built and run independently from the
# temporary C agent resource plane so a provider crash restarts both processes
# without putting C back in charge of workflow transitions. This is crash
# containment, not an OS security boundary: both processes currently share the
# appliance service identity for repository credentials and Unix-socket access.
FROM golang:1.25-bookworm AS wfe-build
WORKDIR /src/server-go
COPY server-go/go.mod server-go/go.sum ./
RUN go mod download
COPY server-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/aimee-wfe ./cmd/aimee-server

# Collect webchat artifacts into a uniform /runtime-web layout. The "1" variant pulls
# from the frontend + Go builds above (only in the build graph when
# WITH_RUNTIME_WEB=1 selects this stage). The "0" variant is empty → no webchat in the
# image (WITH_RUNTIME_WEB=0 opts the UI out of the build entirely).
FROM debian:bookworm-slim AS runtime-web-stage-1
COPY --from=runtime-web-build /out/aimee-runtime-web /runtime-web/aimee-runtime-web
COPY --from=frontend-build /frontend/dist/index.html /runtime-web/index.html
FROM debian:bookworm-slim AS runtime-web-stage-0
RUN mkdir -p /runtime-web
FROM runtime-web-stage-${WITH_RUNTIME_WEB} AS runtime-web-stage

# Optional code-server (full VSCode in the browser). The "1" variant fetches the
# pinned, arch-matched .deb and extracts it under /opt/codeserver (only in the
# build graph when WITH_VSCODE=1). The "0" variant is an empty /opt/codeserver/usr
# so the final COPY is a no-op — no download, no size, in the default/CI build.
# code-server bundles its own Node and defaults to the Open VSX registry.
FROM debian:bookworm-slim AS code-server-stage-1
ARG TARGETARCH
ARG CODE_SERVER_VERSION=4.96.4
# Release downloads go through GitHub/CDN edges that intermittently return 5xx
# (a 504 here failed the whole T3 e2e-docker topology). `curl -fsSL` alone turns
# that into a hard build failure, so retry with backoff. --retry-all-errors is
# required: -f makes an HTTP 504 exit 22, which plain --retry would NOT retry.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-max-time 180 --connect-timeout 30 "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${TARGETARCH}.deb" -o /tmp/cs.deb \
    && mkdir -p /opt/codeserver \
    && dpkg-deb -x /tmp/cs.deb /opt/codeserver \
    && rm /tmp/cs.deb \
    && rm -rf /var/lib/apt/lists/*
FROM debian:bookworm-slim AS code-server-stage-0
RUN mkdir -p /opt/codeserver/usr
FROM code-server-stage-${WITH_VSCODE} AS code-server-stage

FROM debian:bookworm-slim

# Verification builds the KB sources too. They use PostgreSQL 17's asynchronous
# cancellation API, while Debian bookworm ships libpq 15 headers. Add the
# official PGDG repository and pin the verifier client/header family to the same
# current major used by the KB image without changing the production runtime's
# established Debian baseline.
ARG VERIFY_PG_MAJOR=18
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && for attempt in 1 2 3 4 5; do \
         curl -fsS --connect-timeout 10 --max-time 60 \
           -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
           https://www.postgresql.org/media/keys/ACCC4CF8.asc && break; \
         echo "pgdg key fetch failed (attempt ${attempt}/5); backing off"; sleep $((attempt * 5)); \
       done \
    && test -s /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && rm -rf /var/lib/apt/lists/*

# Runtime shared libs the server links: libsqlite3 (DB1), libssl/libcrypto
# (crypto), libzstd + zlib (compression). The server reaches Postgres-backed DB2
# only through aimee-kb, so it does not link libpq itself. curl is for the
# container HEALTHCHECK. libcrypt is retained only to verify a one-time migrated
# PAM hash; libpam0g remains in the Go binary's existing cgo link closure but no
# PAM login path is used. All current browser credentials live in Vault.
#
# The Go workflow engine runs repository verification after implementation.
# Keep the CI-equivalent native, Go, lint, and Python toolchain in the runtime
# image so repository verification does not fail merely because the
# control-plane image was slimmed after its own build stage.
#
# tmux + nodejs + npm are enablers for server-hosted OAuth CLI agents
# (`aimee agent add claude-oauth` / `codex-oauth`): the vendor CLI is installed on
# demand into the home-volume npm prefix (NPM_CONFIG_PREFIX below) and its OAuth
# login runs in a server-side tmux session. The vendor CLIs support the current
# Debian Node release (Node >= 18).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang-format-19 \
        curl \
        git \
        libcrypt1 \
        libcurl4-openssl-dev \
        libpam0g \
        libpam0g-dev \
        libp11-kit-dev \
        libpq-dev \
        libsqlite3-0 \
        libsqlite3-dev \
        libssl3 \
        libssl-dev \
        libzstd1 \
        libzstd-dev \
        nodejs \
        npm \
        openssh-client \
        pkg-config \
        "postgresql-client-${VERIFY_PG_MAJOR}" \
        python3 \
        python3-yaml \
        ripgrep \
        tini \
        tmux \
        zlib1g \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# `git verify` builds the repository's Go surfaces as well as its native ones.
# Copy the exact Go toolchain used for the WFE build instead of installing
# Debian bookworm's older golang-go package, which cannot load go 1.25 modules.
COPY --from=wfe-build /usr/local/go/ /usr/local/go/

# Docker CLI + compose plugin (static client binaries — no daemon). Lets
# aimee-server orchestrate the managed sibling service (aimee-kb)
# with `docker compose up -d` against a mounted host Docker socket, so
# the setup wizard can bring the stack up itself (server-orchestrated deploy). This
# is inert unless the deploy compose mounts /var/run/docker.sock and sets
# AIMEE_DEPLOY_ENABLED=1 (compose.server-managed.yaml); the plain image is
# unprivileged.
ARG TARGETARCH
ARG DOCKER_CLI_VERSION=27.5.1
ARG DOCKER_COMPOSE_VERSION=2.32.4
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) darch=x86_64; carch=x86_64 ;; \
      arm64) darch=aarch64; carch=aarch64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-max-time 180 --connect-timeout 30 "https://download.docker.com/linux/static/stable/${darch}/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz -C /tmp docker/docker; \
    install -m0755 /tmp/docker/docker /usr/local/bin/docker; \
    rm -rf /tmp/docker; \
    mkdir -p /usr/local/lib/docker/cli-plugins; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-max-time 180 --connect-timeout 30 "https://github.com/docker/compose/releases/download/v${DOCKER_COMPOSE_VERSION}/docker-compose-linux-${carch}" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose; \
    chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose; \
    docker --version; docker compose version

# GitHub CLI — backs the wizard's zero-config "Sign in with GitHub": when no
# OAuth App client ID is configured, aimee-server runs GitHub's device flow
# through `gh auth login` (gh's own public app identity), so sign-in works out
# of the box with no app registration (git_oauth_gh.c).
ARG GH_CLI_VERSION=2.96.0
RUN set -eux; \
    gharch="${TARGETARCH:-amd64}"; \
    case "$gharch" in amd64|arm64) ;; *) echo "unsupported TARGETARCH=${gharch}" >&2; exit 1 ;; esac; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-max-time 180 --connect-timeout 30 "https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}/gh_${GH_CLI_VERSION}_linux_${gharch}.tar.gz" \
      | tar -xz -C /tmp "gh_${GH_CLI_VERSION}_linux_${gharch}/bin/gh"; \
    install -m0755 "/tmp/gh_${GH_CLI_VERSION}_linux_${gharch}/bin/gh" /usr/local/bin/gh; \
    rm -rf "/tmp/gh_${GH_CLI_VERSION}_linux_${gharch}"; \
    gh --version

# ast-grep — the binary behind the ast_grep_search MCP tool.
#
# NOTHING installed it before, in this image or any deploy script, so the tool
# has never worked in a container. Worse than absent: `sg` is ALSO util-linux's
# set-group-ID command and is present on every Debian base, so the resolver used
# to find /usr/bin/sg, exec it with --json, capture its usage error as output,
# parse that as NDJSON, and answer "No matches found." An agent asking whether a
# pattern repeats was told no, authoritatively, on a machine where the search
# never ran.
#
# Installed ONLY as `ast-grep`, deliberately. The zip also contains an `sg`, but
# putting that in /usr/local/bin would shadow util-linux's sg for everything in
# the image, and aimee's resolver prefers the unambiguous name anyway -- so
# shadowing a system command would buy nothing and could break unrelated
# callers. The release ships a zip, so unzip is a build-time-only dependency.
# Release downloads go through GitHub/CDN edges that return 5xx in bursts: the
# first run of this step took six 503s inside twenty seconds while the same URL
# served 200 from elsewhere. The retry budget has to outlast a CDN wobble rather
# than a dropped packet, hence 8 attempts across 10 minutes with a 15s gap.
# --retry-all-errors is required because -f turns a 503 into exit 22, which plain
# --retry does NOT retry.
ARG AST_GREP_VERSION=0.45.1
RUN set -eux; \
    agarch="${TARGETARCH:-amd64}"; \
    case "$agarch" in \
      amd64) agtriple="x86_64-unknown-linux-gnu" ;; \
      arm64) agtriple="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported TARGETARCH=${agarch}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip; \
    curl -fsSL --retry 8 --retry-delay 15 --retry-all-errors --retry-max-time 600 \
      --connect-timeout 30 \
      "https://github.com/ast-grep/ast-grep/releases/download/${AST_GREP_VERSION}/app-${agtriple}.zip" \
      -o /tmp/ast-grep.zip; \
    unzip -o /tmp/ast-grep.zip -d /tmp/ast-grep; \
    install -m0755 /tmp/ast-grep/ast-grep /usr/local/bin/ast-grep; \
    rm -rf /tmp/ast-grep /tmp/ast-grep.zip; \
    apt-get purge -y unzip; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*; \
    # Prove it is really ast-grep and not the util-linux sg we just shadowed --
    # the whole point of shipping it is that the resolver's --version check passes.
    ast-grep --version | grep -q '^ast-grep '

# The managed compose the server launches for the orchestrated deploy (default
# AIMEE_DEPLOY_COMPOSE_FILE). Inert until AIMEE_DEPLOY_ENABLED=1 + a mounted socket.
COPY deploy/container/aimee-managed.compose.yaml /opt/aimee/deploy/aimee-managed.compose.yaml

# The embedder registry backs GET /v1/embedders — the setup wizard's page-2 picker.
# The wizard runs BEFORE anything is deployed, so the list cannot come from a running
# gateway; the server reads the same file the gateway and supervisor read.
COPY scripts/embedders.json /opt/aimee/embedders.json

ENV AIMEE_HOME=/var/lib/aimee
# On-demand-installed OAuth CLI agents (claude-code / codex) global-install here,
# on the persistent home volume, so the non-secret CLI binaries survive container
# recreate. OAuth credentials live only in Vault; per-session compatibility files
# are materialized beneath /run and removed with the session.
ENV NPM_CONFIG_PREFIX=/var/lib/aimee/.npm-global
ENV PATH=/var/lib/aimee/.npm-global/bin:/usr/local/go/bin:$PATH
# A host can verify several workflow branches simultaneously. Bound each
# verifier's native build and test fan-out so five workflows do not multiply the
# visible CPU count into hundreds of competing compiler/test processes.
ENV AIMEE_VERIFY_MAKE_JOBS=2
ENV AIMEE_VERIFY_TEST_JOBS=2
# claude-code self-updates on launch by default. In this npm-global-prefix layout
# its updater reinstalls the package WITHOUT re-running the install.cjs postinstall
# that fetches the platform-native binary, leaving an empty package dir and a
# dangling bin/claude symlink -> the launcher becomes "claude: not found" and every
# tmux-cli seat that runs it dies with "failed to send prompt to tmux session".
# aimee owns the pinned install + postinstall (server_cli_oauth.c); disable the
# vendor auto-updater so it cannot brick that install. aimee-server (the tmux
# server) exports this to every pane it spawns. Bind-mounted $AIMEE_HOME means the
# broken state would otherwise persist across container recreate.
ENV DISABLE_AUTOUPDATER=1
# Serve the /v1 HTTP API on 0.0.0.0 (the binary defaults to loopback) so the
# published container port reaches it. The bearer token in the baked aimee.yaml
# is still required on every request.
ENV AIMEE_SERVER_HTTP_BIND=1
# Keep the retired process-global authorizer pinned off. Remote write and control
# capabilities come from the caller's explicit identity grant; for the first
# wizard user that grant is bound to the enrolled mTLS certificate. The legacy
# setting remains parseable only so existing configurations still load.
ENV AIMEE_API_REMOTE_WRITES=off
# Request enrolled client certificates from the first connection even when a
# persisted config predates this setting. Bootstrap remains reachable while the
# listener is optional, then the durable roster promotes it to required mTLS.
ENV AIMEE_API_MTLS=optional
# Standalone by default: no kb configured. Point AIMEE_KB_API_URL at a running
# aimee-kb (e.g. http://aimee-kb:8741) to enable the shared/vector features.
# Mirror tier (workspace-resource-plane §3): the per-workspace bare mirrors +
# reconstructed worktrees live here instead of under AIMEE_HOME, so they sit on a
# dedicated durable volume (declared below) and survive container recreation —
# a detached server keeps its checkouts across restarts. These trees can be large
# and have a different backup lifecycle than DB1, hence a separate mount.
ENV AIMEE_WORKSPACES_DIR=/var/lib/aimee-workspaces

# aimee runs as uid 1000 so it can own its data on storage backends that present
# a uniform owner (e.g. SmoothNAS smoothfs tiers force uid 1000). The entrypoint
# stays root for legacy credential erasure, supervision, and the webchat's
# kernel-attested UDS identity; the server runs as this unprivileged user.
RUN useradd --uid 1000 --user-group --home-dir /var/lib/aimee --create-home --shell /usr/sbin/nologin aimee \
    && mkdir -p /var/lib/aimee-workspaces /mnt/media/cores \
    && chmod 1777 /mnt/media/cores \
    && chown aimee:aimee /var/lib/aimee-workspaces
# Durable mirror-tier state (AIMEE_WORKSPACES_DIR). Declaring it a VOLUME means an
# anonymous volume persists the checkouts across `docker run` recreations even
# when no named volume is mounted; operators can bind/name it for backups.
VOLUME /var/lib/aimee-workspaces /mnt/media/cores
COPY --from=build /src/aimee-server /usr/local/bin/aimee-server
COPY --from=build /module-runtime/bin/ /usr/local/libexec/aimee-modules/
COPY --from=build /module-runtime/grants/server/ /opt/aimee/module-grants/server/
COPY --from=build /module-runtime/server.modules /opt/aimee/module-grants/server.modules
COPY --from=wfe-build /out/aimee-wfe /usr/local/bin/aimee-wfe
# Static TCP<->UDS bridge; aimee-server docker-cp's it into a proxy-mode delegate sandbox.
COPY --from=build /src/aimee-forwarder /usr/local/bin/aimee-forwarder
# See the build stage: delegates reach aimee THROUGH this binary (`aimee mcp serve`
# as their MCP server, `aimee hooks pre` as their PreToolUse guard).
COPY --from=build /src/aimee /usr/local/bin/aimee

# Co-located webchat browser UI: the Go service, the single-file React SPA, and
# Vault-only bootstrap/launch helpers. webchat shares
# AIMEE_HOME so its Unix-socket transports line up with the server.
# Optional webchat: /runtime-web is empty unless built with WITH_RUNTIME_WEB=1. Install
# the binary + SPA when present; the entrypoint skips the browser UI when absent.
COPY --from=runtime-web-stage /runtime-web/ /tmp/runtime-web-stage/
RUN if [ -f /tmp/runtime-web-stage/aimee-runtime-web ]; then \
        install -m 0755 /tmp/runtime-web-stage/aimee-runtime-web /usr/local/bin/aimee-runtime-web; \
        mkdir -p /usr/local/share/aimee-runtime-web; \
        cp /tmp/runtime-web-stage/index.html /usr/local/share/aimee-runtime-web/index.html; \
        echo "aimee: webchat bundled in image"; \
    else echo "aimee: webchat not bundled (built with WITH_RUNTIME_WEB=0)"; fi; \
    rm -rf /tmp/runtime-web-stage
# Optional code-server: /opt/codeserver/usr is empty unless WITH_VSCODE=1, so
# this COPY is a no-op in the default build. When present it lands code-server at
# /usr/bin/code-server; the webchat supervisor launches a per-user instance.
COPY --from=code-server-stage /opt/codeserver/usr/ /usr/
RUN if command -v code-server >/dev/null 2>&1; then echo "aimee: code-server bundled ($(code-server --version 2>/dev/null | head -1))"; else echo "aimee: code-server not bundled (built with WITH_VSCODE=0)"; fi
# PAM service for dashboard logins. runtime-web authenticates through
# smoothgui/auth against /etc/pam.d/<service>; with no file every login fails as
# "authentication unavailable".
COPY deploy/container/pam.d-aimee /etc/pam.d/aimee
COPY deploy/container/runtime-web-lib.sh /usr/local/bin/runtime-web-lib.sh
COPY deploy/container/optional-modules-lib.sh /usr/local/bin/optional-modules-lib.sh
COPY deploy/container/plane-supervisor.sh /usr/local/bin/plane-supervisor.sh
COPY deploy/container/module-supervisor.sh /usr/local/bin/module-supervisor.sh
COPY deploy/container/core-storage.sh /usr/local/bin/core-storage.sh
COPY deploy/container/server-entrypoint.sh /usr/local/bin/aimee-server-entrypoint
RUN chmod +x /usr/local/bin/aimee-server-entrypoint \
    /usr/local/bin/core-storage.sh /usr/local/bin/plane-supervisor.sh \
    /usr/local/bin/module-supervisor.sh

# Baked default config (enables the inbound /v1 HTTP listener: port + bearer).
# Kept OUTSIDE $AIMEE_HOME so a bind-mounted (empty) volume can't shadow it; the
# entrypoint seeds it into $AIMEE_HOME/aimee.yaml on first start.
COPY deploy/container/aimee-server.yaml /opt/aimee/defaults/aimee.yaml
# Default dev-lifecycle workflow(s) for autonomous development (default-on). The
# entrypoint seeds them into $AIMEE_HOME/workflows on first start.
COPY config/workflows/ /opt/aimee/defaults/workflows/
# Roundtable presets those workflows name. A roundtable review resolves only a
# saved roundtable, so a workflow gate cannot run until its preset exists. The
# entrypoint seeds them into $AIMEE_HOME/roundtables on first start.
COPY config/roundtables/ /opt/aimee/defaults/roundtables/

# Runs as root for legacy erasure, supervision, and webchat's kernel-attested UDS
# identity; aimee-server itself is dropped to the "aimee" user.
WORKDIR /var/lib/aimee
# 8740 = server /v1 (plaintext, loopback-only); 8743 = server /v1 over native TLS
# (the remote thin-client port); 8443 = aimee-runtime-web browser UI (HTTPS).
EXPOSE 8740 8743 8443

# NOTE: the server's worker threads need a 64 MB stack (the 8 MB container
# default overflows during startup and the process segfaults). The entrypoint
# raises the soft stack rlimit to 64 MB before launching the server, so no
# runtime --ulimit is required on hosts whose hard limit allows it (the usual
# case; hard stack defaults to unlimited). A runtime ulimit still works:
#   docker run --ulimit stack=67108864 ...   (mirrors systemd LimitSTACK)

# Health probe: every TCP /v1 request (including /v1/health) is authenticated,
# so an unauthenticated probe gets 401 — which still proves the listener is up
# and serving. Treat 200 (e.g. when the baked bearer happens to match) or 401 as
# healthy; only a connection failure ("000") is unhealthy. This keeps the probe
# independent of the random or operator-supplied Vault-held bearer.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -s -o /dev/null -w '%{http_code}' \
        http://127.0.0.1:8740/v1/health | grep -qE '^(200|401)$'

# The entrypoint must consume and unset first-boot credentials before tini
# becomes the long-lived PID-1 subreaper; it execs tini itself after that scrub.
ENTRYPOINT ["aimee-server-entrypoint"]
