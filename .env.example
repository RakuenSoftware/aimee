# Copy this file to .env for explicit local Compose overrides. The live .env is
# ignored by Git and excluded from Docker build contexts because it may contain
# enrollment material or credentials.
COMPOSE_PROFILES=

# Optional split/external authority enrollment values. Leave blank for the
# managed wizard path; see docs/QUICKSTART.md before setting these.
# AIMEE_SERVER_ID=YOUR_ENROLLED_SERVER_ID
# AIMEE_SERVER_TEAM_ID=YOUR_NUMERIC_TEAM_ID
# AIMEE_SERVER_MGMT_JWKS_TRUST_BUNDLE=/run/aimee/management/jwks-trust-bundle.json
# AIMEE_KB_CONN=aimee://THE_ONE_TIME_ENROLLMENT_STRING
