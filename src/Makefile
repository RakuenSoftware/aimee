# Third-party /v1 public-API smoke test (curl + jq only). Self-skips when no
# aimee-kb is reachable, so it is safe to run anywhere; point it at a live
# service with KB_BASE_URL / KB_BEARER_TOKEN to validate the stability contract.
v1-third-party-test:
	./tests/test_v1_third_party.sh

# Run each generated /v1 SDK (api/sdks/<lang>) against a live aimee-kb. Per-lang
# PASS/SKIP/FAIL; SKIPs languages whose toolchain/deps are absent and self-skips
# when no kb is reachable, so it is safe anywhere. Point it at a deployed kb with
# KB_BASE_URL / KB_BEARER_TOKEN.
v1-sdk-smoke:
	@../scripts/sdk-smoke.sh

