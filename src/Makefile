# Create build ID file if it doesn't exist (for plain 'make')
$(BUILD_ID_FILE):
	@mkdir -p build && date +%s > $@

# Files that embed the build ID — recompiled when it changes.
# posix/cli_client.c uses shared compatibility helpers to restart stale servers
# when their advertised version/protocol surface is incompatible.
$(OBJDIR)/cli_client.o: cli_client.c $(BUILD_ID_FILE)
	@mkdir -p $(OBJDIR)
	$(CC) -c $(C_FLAGS) -DAIMEE_BUILD_ID='"$(BUILD_ID)"' -o $@ $<

$(OBJDIR)/posix/cli_client.o: posix/cli_client.c $(BUILD_ID_FILE)
	@mkdir -p $(dir $@)
	$(CC) -c $(C_FLAGS) -DAIMEE_BUILD_ID='"$(BUILD_ID)"' -o $@ $<

$(OBJDIR)/server/server.o: server/server.c $(BUILD_ID_FILE)
	@mkdir -p $(dir $@)
	$(CC) -c $(C_FLAGS) -DAIMEE_BUILD_ID='"$(BUILD_ID)"' -o $@ $<

$(OBJDIR)/cJSON.o: vendor/cJSON.c
	@mkdir -p $(OBJDIR)
	$(CC) -c -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s -w -Ivendor/headers -o $@ $<

PREFIX ?= /usr/local
DATADIR ?= $(PREFIX)/share/aimee
CFLAGS_DATADIR = -DAIMEE_DATADIR='"$(DATADIR)"'

install:
	$(AIMEE_RUNTIME_MUTATION_GUARD)
	@mkdir -p build && date +%s > $(BUILD_ID_FILE)
	$(MAKE) $(BINARY) $(WEBCHAT) $(SERVER) $(KB) $(GATEWAY)
	rm -f $(PREFIX)/bin/aimee-client $(PREFIX)/bin/aimee-worker
	install -m 755 $(BINARY) $(PREFIX)/bin/aimee
	install -m 755 $(WEBCHAT) $(PREFIX)/bin/aimee-webchat
	install -m 755 $(SERVER) $(PREFIX)/bin/aimee-server
	install -m 755 $(KB) $(PREFIX)/bin/aimee-kb
	install -m 755 $(GATEWAY) $(PREFIX)/bin/aimee-gateway
	@mkdir -p $(DATADIR)
