# Generate the Markdown API reference under docs/gen/ from the OpenAPI spec.
# The output is committed; regenerating on an unchanged spec is a no-op.
docs-check:
	@python3 ../scripts/check-docs.py

docs-gen:
	@python3 ../scripts/gen-api-docs.py
	@python3 ../scripts/gen-reference-docs.py
	@python3 ../scripts/gen-v1-route-descriptor.py

# The subject grammar's SQL corpus, generated from src/tests/subject_corpus.h.
subject-corpus-gen:
	@python3 ../scripts/gen-subject-corpus-sql.py

# CI gate: fail if the generated SQL corpus is stale. Without this, editing the
# corpus would update the C cross-check while the Postgres CHECK kept being tested
# against the previous list — reintroducing exactly the silent drift the corpus
# exists to prevent.
subject-corpus-check: subject-corpus-gen
	@if ! git -C .. diff --quiet -- scripts/gen/subject-corpus.sql; then \
		echo "subject-corpus-check: scripts/gen/subject-corpus.sql is stale — run 'make subject-corpus-gen' and commit the result"; \
		git -C .. --no-pager diff --stat -- scripts/gen/subject-corpus.sql; \
		exit 1; \
	fi; \
	echo "subject-corpus-check: ok"

# CI gate: fail if docs/gen is stale relative to the committed spec.
# --plant-test first: docs-gen-check only diffs the OUTPUT against git, so a
# generator whose regex stopped matching would emit an empty document and this
# would read it as an ordinary content change. The plant proves the generator
# refuses a source it cannot parse. (That is not hypothetical -- renaming a tier
# token once took cli-commands.md from 812 lines to 8, silently.)
docs-gen-check: docs-gen
	@python3 ../scripts/gen-reference-docs.py --plant-test
	@if ! git -C .. diff --quiet -- docs/gen/; then \
		echo "docs-gen-check: docs/gen is stale — run 'make docs-gen' and commit the result"; \
		git -C .. --no-pager diff --stat -- docs/gen/; \
		exit 1; \
	fi; \
	echo "docs-gen-check: ok"

# CI gate: every endpoint documented in api/openapi-v1.yaml must be routed by
# the aimee-kb HTTP server (spec ↔ implementation conformance).
api-conformance-check:
	@python3 ../scripts/check-api-conformance.py

# CI gate: every endpoint documented in api/openapi-server-v1.yaml must be
# routed by the aimee-server HTTP surface (spec ↔ implementation conformance).
server-api-conformance-check:
	@python3 ../scripts/check-api-conformance-server.py

# CI gate: every NDJSON method in server_dispatch_table[] must have a first-
# class /v1 route or a documented exclusion (op-parity, WP1.fin).
v1-method-coverage-check:
	@python3 ../scripts/check-v1-method-coverage.py

# CI gate: the thin client's generated method->/v1 route map
# (src/cli_v1_routes_gen.inc) must be in sync with the server registry, so the
# client keeps calling first-class routes instead of regressing to /v1/rpc.
cli-v1-routes-check:
	@python3 ../scripts/check-cli-v1-routes.py

# CI gate: a test target that links the CLI-manifest route must link every
# emitter that route calls. The link list is hand-maintained, so each new served
# body (dispatch rows, the no-arg list, the argument specs) broke the same two
# targets with the same "undefined reference to cli_*_defs_to_json" — three
# times, each found by CI after a push. This derives the requirement from what
# the route actually calls.
manifest-emitter-linkage-check:
	@python3 ../scripts/check-manifest-emitter-linkage.py

# CI gate: a served spec's numeric TYPE must match the parse its marshaller
# actually calls. memory.delete shipped saying number_lenient (atoi) where the
# marshaller used atoll(), so a memory id above 2^31 would have been truncated
# by the thin client and addressed a different row. The differential test could
# not see it: its samples come from the spec, and every generated id was small.
# This compares the two directly instead of hoping a sample straddles the edge.
argspec-numeric-parity-check:
	@python3 ../scripts/check_argspec_numeric_parity.py

# CI gate: a handler bound to an async (rh_dispatch_op_async) /v1 route must write
# its reply before returning. A detached-thread reply lands after the op-run bridge
# has read and closed its socketpair, so the run fails with "rpc produced no
# response" — which is how the whole KB write surface (kb.build/update/ingest/
# docs.push) and graph.sync_code were dead over /v1.
async-op-handlers-check:
	@python3 ../scripts/check-async-op-handlers.py

# CI gate: the /v1 route table's first-match dispatch stays order-correct — a
# more-specific route (e.g. the exact /v1/workflow/items/all) must never be
# shadowed by a later generic prefix ({id}) route. Makes the ordering constraint
# explicit and is the prerequisite for safely generating g_v1_routes.
v1-route-order-check:
	@python3 ../scripts/check-v1-route-order.py

# CI gate: every routed thin-client command has a client_help[] entry, so
# `aimee help <cmd>` cannot answer "Unknown command" for a command that works.
cli-help-coverage-check:
	@python3 ../scripts/check-cli-help-coverage.py
	@python3 ../scripts/check-schema-alter-order.py

# CI gate: every kb /v1/intelligence/* route is surfaced to the thin client via
# an aimee-server dispatch handler (or explicitly marked kb-direct), so no kb
# capability is silently unreachable behind a dead cmd_* handler.
kb-intelligence-surfaced-check:
	@python3 ../scripts/check-kb-intelligence-surfaced.py

proposal-links-check:
	@python3 ../scripts/check-proposal-links.py

# The dated pending-audit manifest must keep describing the tree: every row's
