witness-verify: $(WITNESS_VERIFY)

# Lean build: size-optimized, stripped binary for minimal deployments.
# Uses -Os (size opt), -g0 (no debug info), -s (strip symbols), and
# --gc-sections / -dead_strip to eliminate unused code.
# Produces ../aimee-lean and ../aimee-server-lean; target is under 1.5MB.
lean:
	$(AIMEE_RUNTIME_MUTATION_GUARD)
	$(MAKE) all server \
		BINARY="$(LEAN_BINARY)" \
		SERVER="$(LEAN_SERVER)" \
		KB="$(LEAN_KB)" \
		OBJDIR="$(LEAN_OBJDIR)" \
		EXTRA_C_FLAGS="-Os -g0 -ffunction-sections -fdata-sections" \
		EXTRA_L_FLAGS="-s $(LEAN_GC_FLAGS)"
	@echo "Lean binary sizes:"
	@ls -lh $(LEAN_BINARY) $(LEAN_SERVER) $(LEAN_KB)
	@lean_size=$$(stat -c%s $(LEAN_SERVER) 2>/dev/null || stat -f%z $(LEAN_SERVER) 2>/dev/null); \
	limit=$$((1500 * 1024)); \
	if [ "$$lean_size" -le "$$limit" ]; then \
		echo "lean: ok — server binary $$lean_size bytes (limit 1536000)"; \
	else \
		echo "lean: WARNING — server binary $$lean_size bytes exceeds 1.5MB limit"; \
		exit 1; \
	fi

# Dynamic linking policy check: enforce DB ownership boundaries and verify
# daemon system libraries are dynamically linked. Only runs on Linux (ldd) and
# macOS (otool). Skipped on Windows where MinGW runtime is intentionally static.
check-linking: $(BINARY) $(ALL_RUNTIME_WEB) $(SERVER) $(KB) $(GATEWAY)
ifeq ($(OS),Windows_NT)
	@echo "check-linking: skipped on Windows (MinGW runtime is intentionally static)"
else ifeq ($(UNAME_S),Darwin)
	@fail=0; \
	for bin in $(BINARY) $(ALL_RUNTIME_WEB) $(SERVER) $(KB) $(GATEWAY); do \
		echo "check-linking: $$bin"; \
		deps=$$(otool -L "$$bin" | tail -n+2); \
		if [ "$$bin" = "$(BINARY)" ]; then \
			for lib in libsqlite3 libpq; do \
				if echo "$$deps" | grep -q "$$lib"; then \
					echo "  ERROR: $$lib linked into DB-free client"; \
					fail=1; \
				else \
					echo "  $$lib: not found (client boundary ok)"; \
				fi; \
			done; \
			continue; \
		fi; \
		if [ "$$bin" = "$(RUNTIME_WEB)" ]; then \
			if echo "$$deps" | grep -q libpq; then \
				echo "  ERROR: libpq linked into webchat (no DB2 access)"; \
				fail=1; \
			else \
				echo "  libpq: not found (webchat boundary ok)"; \
			fi; \
			continue; \
		fi; \
		case "$$bin" in \
			*aimee-server*) \
				if echo "$$deps" | grep -q libpq; then \
					echo "  ERROR: libpq linked into DB1-only server"; \
					fail=1; \
				else \
					echo "  libpq: not found (server boundary ok)"; \
				fi; \
				if command -v readelf >/dev/null 2>&1 && \
				   readelf -Ws "$$bin" | awk '$$7 != "UND" && $$8 ~ /^(db2_|PQ[A-Z])/ { found=1 } END { exit !found }'; then \
					echo "  ERROR: DB2 symbols present in DB1-only server"; \
					fail=1; \
				else \
					echo "  DB2 symbols: not found (server boundary ok)"; \
				fi ;; \
			*aimee-kb*) \
				if echo "$$deps" | grep -q libsqlite3; then \
					echo "  ERROR: libsqlite3 linked into DB2-only kb"; \
					fail=1; \
				else \
					echo "  libsqlite3: not found (kb boundary ok)"; \
				fi; \
				if echo "$$deps" | grep -q libpq; then \
					echo "  libpq: dynamic (kb owns DB2)"; \
				else \
					echo "  ERROR: libpq not linked into DB2-owning kb"; \
					fail=1; \
				fi; \
				if command -v readelf >/dev/null 2>&1 && readelf -Ws "$$bin" | grep -Eq 'db1_|sqlite3_'; then \
					echo "  ERROR: DB1/sqlite symbols present in DB2-only kb"; \
					fail=1; \
				else \
					echo "  DB1/sqlite symbols: not found (kb boundary ok)"; \
				fi; \
				continue ;; \
		esac; \
		for lib in libsqlite3 libssl libcrypto; do \
			case "$$bin" in \
				*aimee-server*) ;; \
				*) [ "$$lib" = "libssl" ] || [ "$$lib" = "libcrypto" ] && continue ;; \
			esac; \
			if echo "$$deps" | grep -q "$$lib"; then \
				echo "  $$lib: dynamic (ok)"; \
			else \
				echo "  $$lib: not found (ok if unused by this binary)"; \
			fi; \
		done; \
		if echo "$$deps" | grep -q '/usr/local/lib.*\.a'; then \
			echo "  WARNING: static library detected in $$bin"; \
			fail=1; \
		fi; \
	done; \
	if [ "$$fail" = "1" ]; then exit 1; fi; \
	echo "check-linking: ok"
else
	@fail=0; \
	for bin in $(BINARY) $(ALL_RUNTIME_WEB) $(SERVER) $(KB) $(GATEWAY); do \
		echo "check-linking: $$bin"; \
		deps=$$(ldd "$$bin"); \
		if [ "$$bin" = "$(BINARY)" ]; then \
			for lib in libsqlite3 libpq; do \
				if echo "$$deps" | grep -q "$$lib"; then \
					echo "  ERROR: $$lib linked into DB-free client"; \
					fail=1; \
				else \
					echo "  $$lib: not found (client boundary ok)"; \
				fi; \
			done; \
			continue; \
		fi; \
		if [ "$$bin" = "$(RUNTIME_WEB)" ]; then \
			if echo "$$deps" | grep -q libpq; then \
				echo "  ERROR: libpq linked into webchat (no DB2 access)"; \
				fail=1; \
			else \
				echo "  libpq: not found (webchat boundary ok)"; \
			fi; \
			continue; \
		fi; \
		case "$$bin" in \
			*aimee-server*) \
				if echo "$$deps" | grep -q libpq; then \
					echo "  ERROR: libpq linked into DB1-only server"; \
					fail=1; \
				else \
					echo "  libpq: not found (server boundary ok)"; \
				fi; \
				if command -v readelf >/dev/null 2>&1 && \
				   readelf -Ws "$$bin" | awk '$$7 != "UND" && $$8 ~ /^(db2_|PQ[A-Z])/ { found=1 } END { exit !found }'; then \
					echo "  ERROR: DB2 symbols present in DB1-only server"; \
					fail=1; \
				else \
					echo "  DB2 symbols: not found (server boundary ok)"; \
				fi ;; \
			*aimee-kb*) \
				if echo "$$deps" | grep -q libsqlite3; then \
					echo "  ERROR: libsqlite3 linked into DB2-only kb"; \
					fail=1; \
				else \
					echo "  libsqlite3: not found (kb boundary ok)"; \
				fi; \
				if echo "$$deps" | grep -q libpq; then \
					echo "  libpq: dynamic (kb owns DB2)"; \
				else \
					echo "  ERROR: libpq not linked into DB2-owning kb"; \
					fail=1; \
				fi; \
				if command -v readelf >/dev/null 2>&1 && readelf -Ws "$$bin" | grep -Eq 'db1_|sqlite3_'; then \
					echo "  ERROR: DB1/sqlite symbols present in DB2-only kb"; \
					fail=1; \
				else \
					echo "  DB1/sqlite symbols: not found (kb boundary ok)"; \
				fi; \
				continue ;; \
		esac; \
		for lib in libsqlite3 libssl libcrypto; do \
			case "$$bin" in \
				*aimee-server*) ;; \
				*) [ "$$lib" = "libssl" ] || [ "$$lib" = "libcrypto" ] && continue ;; \
			esac; \
			if echo "$$deps" | grep -q "$$lib"; then \
				echo "  $$lib: dynamic (ok)"; \
			else \
				echo "  $$lib: not found (ok if unused by this binary)"; \
			fi; \
		done; \
		if ldd "$$bin" | grep -q 'not a dynamic executable'; then \
			echo "  ERROR: $$bin is statically linked"; \
			fail=1; \
		fi; \
	done; \
	if [ "$$fail" = "1" ]; then exit 1; fi; \
	echo "check-linking: ok"
endif

# The harness starts the DB1 module the way a container's supervisor does, so
# the module is a prerequisite: without it every migrated operation answers
# "capability absent" and the failure reads as a broken store.
integration-tests: $(BINARY) $(SERVER) $(OBJDIR)/aimee-module-db1 $(CONFIG_MODULE)
	./tests/test_integration.sh
	python3 ../scripts/test-thin-client-remote-exclusive.py $(BINARY)
	python3 ../scripts/test-served-argspec-e2e.py $(BINARY)

init-migrate-service-test: $(BINARY) $(SERVER) $(CONFIG_MODULE)
	./tests/test_init_migrate_service.sh

# The kb entrypoint's embedder gate. Needs no binary, no cluster and no image: it
# sources the entrypoint's definitions and calls them directly.
kb-entrypoint-test:
	./tests/test_kb_entrypoint.sh

# The server entrypoint's module-grant seeding rules: stale image default vs
# operator policy, and the stale-pin reconciliation that once bricked a live
# server. Needs no image -- it runs the entrypoint's own block against fixtures.
module-grants-test:
	./tests/test_module_grants.sh

# The managed compose `.env` derived at every container start. Needs $(SERVER)
# because the strongest cases run the real emitter rather than grepping the
# entrypoint: an unset AIMEE_KB_VARIANT resolves the kb image to the
# embedderless aimee-kb SILENTLY, so the value itself is what must be asserted.
deploy-compose-env-test: $(BINARY) $(SERVER) $(CONFIG_MODULE)
	./tests/test_deploy_compose_env.sh

# `workflow show/validate` must accept the name `workflow list` prints. Needs the
