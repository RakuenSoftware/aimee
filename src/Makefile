CC      = gcc
OBJDIR  = build/obj

ifeq ($(OS),Windows_NT)
EXEEXT  = .exe
NULLDEV = NUL
RM      = del /Q
else
EXEEXT  =
NULLDEV = /dev/null
RM      = rm -rf
endif
BINARY  = ../aimee$(EXEEXT)
SERVER  = ../aimee-server$(EXEEXT)
KB      = ../aimee-kb$(EXEEXT)
WEBCHAT = ../aimee-webchat$(EXEEXT)
GATEWAY = ../aimee-gateway$(EXEEXT)
RETIRED_ROOT_BINARIES = ../aimee-client$(EXEEXT) ../aimee-worker$(EXEEXT)

# aimee-webchat is the only Go artifact and needs the Go toolchain (go.mod pins a
# newer Go than some distros package, e.g. Debian 13 ships 1.24). The C services
# (aimee / aimee-server / aimee-kb) need no Go, so `make all` builds webchat only
# when `go` is on PATH and otherwise skips it with a note — a source install on a
# box without Go still gets a working core instead of a hard `go: not found`.
HAVE_GO := $(shell command -v go >/dev/null 2>&1 && echo 1)
ifeq ($(HAVE_GO),1)
ALL_WEBCHAT = $(WEBCHAT)
else
ALL_WEBCHAT =
endif

define AIMEE_RUNTIME_MUTATION_GUARD
	@if [ -n "$$AIMEE_TUI_SESSION" ]; then \
		echo "aimee: refusing to mutate runtime target '$@' from inside the TUI" >&2; \
		exit 2; \
	fi
endef

# Build ID: identifies a specific local build for diagnostics/tests. Written to
# build/build_id.txt; regenerated by `make install` to force a new value each
# time binaries are installed. For plain `make`, the existing ID is reused (or
# created if missing) so incremental builds stay fast.
BUILD_ID_FILE = build/build_id.txt
BUILD_ID = $(shell mkdir -p build && cat $(BUILD_ID_FILE) 2>$(NULLDEV) || echo dev)

# Git version string: embedded at build time for `aimee --version` and
# self-update detection.  Falls back to the hardcoded value in aimee.h when
# git metadata is unavailable (e.g. tarball builds).
GIT_VERSION     := $(shell git describe --tags --always 2>$(NULLDEV))
GIT_COMMIT_TIME := $(shell git log -1 --format=%ct HEAD 2>$(NULLDEV))
ifneq ($(GIT_VERSION),)
VERSION_FLAGS = -DAIMEE_VERSION='"$(GIT_VERSION)"'
else
VERSION_FLAGS =
endif
ifneq ($(GIT_COMMIT_TIME),)
VERSION_FLAGS += -DAIMEE_GIT_COMMIT_TIME=$(GIT_COMMIT_TIME)L
endif

# Branch tracking: auto-clean stale object files when the git branch changes.
# Prevents linker errors from object files compiled on a different branch.
BRANCH_FILE = $(OBJDIR)/branch.txt
CURRENT_BRANCH = $(shell git rev-parse --abbrev-ref HEAD 2>$(NULLDEV) || echo unknown)
PREVIOUS_BRANCH = $(shell cat $(BRANCH_FILE) 2>$(NULLDEV))
ifneq ($(CURRENT_BRANCH),$(PREVIOUS_BRANCH))
ifneq ($(PREVIOUS_BRANCH),)
$(shell $(RM) $(OBJDIR) 2>$(NULLDEV))
$(info aimee: branch switched ($(PREVIOUS_BRANCH) -> $(CURRENT_BRANCH)) — cleaned stale objects)
endif
$(shell mkdir -p $(dir $(BRANCH_FILE)) && echo "$(CURRENT_BRANCH)" > $(BRANCH_FILE))
endif

# Version tracking: auto-clean stale object files when the git commit hash changes.
# Prevents AIMEE_VERSION constant mismatches when HEAD changes (e.g. git commit --amend).
VERSION_FILE = $(OBJDIR)/version.txt
PREVIOUS_VERSION = $(shell cat $(VERSION_FILE) 2>$(NULLDEV))
ifneq ($(GIT_VERSION),$(PREVIOUS_VERSION))
ifneq ($(PREVIOUS_VERSION),)
$(shell $(RM) $(OBJDIR) 2>$(NULLDEV))
$(info aimee: version changed ($(PREVIOUS_VERSION) -> $(GIT_VERSION)) — cleaned stale objects in $(OBJDIR))
endif
$(shell mkdir -p $(dir $(VERSION_FILE)) && echo "$(GIT_VERSION)" > $(VERSION_FILE))
endif

# Eagerly create platform subdirectories at variable-expansion time so parallel
# builds (-j) on macOS GNU make 3.81 don't race on directory creation. Order-only
# prerequisites have edge cases in older make versions; $(shell) is bulletproof.
# NOTE: must come AFTER the branch-switch block above, which deletes $(OBJDIR) on
# branch changes — if this ran before, the directories would be wiped and gcc
# would fail trying to write .d dependency files into non-existent subdirectories.
_DUMMY := $(shell mkdir -p $(OBJDIR) $(OBJDIR)/posix $(OBJDIR)/linux $(OBJDIR)/mac $(OBJDIR)/windows $(OBJDIR)/tests $(OBJDIR)/db1 $(OBJDIR)/db2)

C_FLAGS = -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s -Wall -Wextra -Werror -Wno-unused-parameter -Wno-format-truncation -Wno-unused-result -MMD -MP -I. -Iheaders -Ivendor/headers -Idb1 -Idb2 -Iworkflow $(VERSION_FLAGS) $(EXTRA_C_FLAGS)

# DB2 client flags are discovered with pkg-config because provider headers are
# not always installed under the compiler default include path. See
# docs/proposals/accepted/three-db-split-user-shared-vectors.md.
PQ_CFLAGS := $(shell pkg-config --cflags libpq 2>$(NULLDEV))
PQ_LIB    := $(shell pkg-config --libs libpq 2>$(NULLDEV))
ifeq ($(strip $(PQ_LIB)),)
    PQ_LIB := -lpq
endif
C_FLAGS  += $(PQ_CFLAGS)

ifeq ($(OS),Windows_NT)
    C_FLAGS += -DAIMEE_WINDOWS -D_WIN32_WINNT=0x0A00
endif

UNAME_S := $(shell uname -s)

# Platform-specific HTTP library
ifeq ($(OS),Windows_NT)
    HTTP_LIB = -lwinhttp
    WINDOWS_LIBS = -lws2_32 -lbcrypt -lwinhttp
else
    HTTP_LIB =
    WINDOWS_LIBS =
endif

# PAM support (optional: set WITH_PAM=1 to enable, auto-detected if libpam-dev present)
ifeq ($(OS),Windows_NT)
WITH_PAM ?= 0
else
WITH_PAM ?= $(shell echo '\#include <security/pam_appl.h>' | $(CC) -xc -fsyntax-only - 2>$(NULLDEV) && echo 1 || echo 0)
endif
ifeq ($(WITH_PAM),1)
    PAM_FLAGS = -DWITH_PAM
    PAM_LIBS  = -lpam
else
    PAM_FLAGS =
    PAM_LIBS  =
endif

# libsecret support (optional: set WITH_LIBSECRET=1 to enable, auto-detected if libsecret-1-dev present)
ifeq ($(OS),Windows_NT)
WITH_LIBSECRET ?= 0
else
WITH_LIBSECRET ?= $(shell pkg-config --exists libsecret-1 2>$(NULLDEV) && echo 1 || echo 0)
endif
ifeq ($(WITH_LIBSECRET),1)
    LIBSECRET_FLAGS = -DWITH_LIBSECRET $(shell pkg-config --cflags libsecret-1)
    LIBSECRET_LIBS  = $(shell pkg-config --libs libsecret-1)
else
    LIBSECRET_FLAGS =
    LIBSECRET_LIBS  =
endif

# In-client TLS for https:// remote servers (optional). OpenSSL-backed; enabled
# on POSIX (server/kb already require OpenSSL), disabled on Windows where the
# MinGW thin client has no OpenSSL and refuses https:// instead.
ifeq ($(OS),Windows_NT)
WITH_TLS ?= 0
else
WITH_TLS ?= 1
endif
ifeq ($(WITH_TLS),1)
    TLS_FLAGS = -DWITH_TLS
    TLS_LIBS  = -lssl -lcrypto
else
    TLS_FLAGS =
    TLS_LIBS  =
endif

# dashboard.c is always compiled: provides api_metrics, api_delegations, and
# the other JSON API functions used by the server RPC layer.  The browser UI
# (aimee-webchat) is now the standalone Go binary and no longer embedded here.
ifeq ($(OS),Windows_NT)
    UI_PLATFORM_SRCS = windows/dashboard.c
else
    UI_PLATFORM_SRCS = posix/dashboard.c
endif

C_FLAGS += $(PAM_FLAGS) $(LIBSECRET_FLAGS)

ifeq ($(UNAME_S),Darwin)
    PLATFORM_FRAMEWORKS = -framework Security -framework CoreFoundation
    LEAN_GC_FLAGS       = -Wl,-dead_strip
else ifeq ($(OS),Windows_NT)
    PLATFORM_FRAMEWORKS =
    LEAN_GC_FLAGS       =
else
    PLATFORM_FRAMEWORKS =
    LEAN_GC_FLAGS       = -Wl,--gc-sections
endif

ifeq ($(OS),Windows_NT)
    PIC_FLAGS =
else
    PIC_FLAGS = -fPIC
endif

C_FLAGS += $(PIC_FLAGS)

# Client sources are intentionally DB-blind. They compile without DB include
# paths or libpq discovery flags, and link without DB libraries.
CLIENT_C_FLAGS := $(filter-out -I. -Idb1 -Idb2 $(PQ_CFLAGS),$(C_FLAGS)) $(TLS_FLAGS)

# --- Lean build profile ---
LEAN_BINARY = ../aimee-lean$(EXEEXT)
LEAN_SERVER = ../aimee-server-lean$(EXEEXT)
LEAN_KB = ../aimee-kb-lean$(EXEEXT)
LEAN_OBJDIR = build/obj-lean

# Linker flag sets (layered -- each level adds to the previous)
L_MINIMAL = -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s -lpthread $(EXTRA_L_FLAGS)
L_CORE    = -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s -lsqlite3 $(PQ_LIB) -lm -lpthread -lzstd $(EXTRA_L_FLAGS)
L_AGENT   = $(L_CORE) -lssl -lcrypto $(HTTP_LIB)
L_FULL    = $(L_AGENT) $(PAM_LIBS) $(LIBSECRET_LIBS) $(PLATFORM_FRAMEWORKS) $(WINDOWS_LIBS)
L_CLIENT  = $(L_MINIMAL) $(TLS_LIBS) -lm
L_GATEWAY = $(L_MINIMAL) -lssl -lcrypto $(HTTP_LIB)
# Server (DB1 daemon) link flags — same as L_FULL minus libpq. The daemon
# no longer carries DB2 code; the only postgres-bound work routes
# through the kb client socket to aimee-kb, which carries libpq itself.
L_SERVER  = -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s -lsqlite3 -lm -lpthread $(EXTRA_L_FLAGS) -lssl -lcrypto $(HTTP_LIB) $(PAM_LIBS) $(LIBSECRET_LIBS) $(PLATFORM_FRAMEWORKS) $(WINDOWS_LIBS)
L_KB      = -Os -flto -ffunction-sections -fdata-sections -Wl,--gc-sections -s $(PQ_LIB) -lm -lpthread -lzstd $(EXTRA_L_FLAGS) -lssl -lcrypto $(HTTP_LIB) $(PAM_LIBS) $(LIBSECRET_LIBS) $(PLATFORM_FRAMEWORKS) $(WINDOWS_LIBS)
ifeq ($(OS),Windows_NT)
    L_FULL += -ladvapi32
    L_KB += -ladvapi32
endif

