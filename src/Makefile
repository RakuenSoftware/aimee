agent_help_data.h: ../docs/agent.md
	@tmp='$@.$$$$.tmp'; \
	python3 -c "\
import sys; \
data = open(sys.argv[1], 'rb').read(); \
print('/* Auto-generated from docs/agent.md -- do not edit directly */'); \
print('static const unsigned char agent_help_data[] = {'); \
print(', '.join('0x{:02x}'.format(b) for b in data) + '};'); \
print('static const unsigned int agent_help_data_len = {};'.format(len(data))); \
" $< > "$$tmp" && mv "$$tmp" $@

