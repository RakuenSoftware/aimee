# Pinned clang-format version. Must match what CI installs so `make lint`
# produces identical results everywhere. Override with CLANG_FORMAT=... if
# you genuinely need a different binary.
CLANG_FORMAT ?= clang-format-19

# The lint job runs `make lint` WITHOUT building the shipping binaries, so the D7
# artefact layer (layer 4) has nothing to inspect and would fail strict ("nothing
# built"). Run it with --allow-unbuilt in the lint context: layers 1-3 (source +
# build text) are the authoritative, complete-by-construction guarantee and run
# regardless; layer 4 is a best-effort backstop that only bites where binaries are
# actually built (a dedicated build+check context, or a local `make all` first).
# Target-specific, so a standalone `make bus-blast-radius-check` stays strict.
lint: BUS_BLAST_RADIUS_FLAGS := --allow-unbuilt

# Every gate runs, not just up to the first failure.
#
# This was `lint: <36 prerequisites>`, so make stopped at the first that failed.
# A contributor fixes that one, sees lint pass, and ships — with every later gate
# still unrun. It is quietly expensive: one change adding a /v1 route tripped
# docs-gen-check; fixing that revealed server-api-conformance-check; fixing THAT
# revealed cli-v1-routes-check. Three CI round-trips for a single omission that
# one local run should have reported in full.
#
# Sequential and in the listed order, because some checks read files an earlier
# one regenerates. BUS_BLAST_RADIUS_FLAGS is passed down explicitly: it is a
# target-specific variable on `lint`, and target-specific variables do NOT cross
# a recursive make, so bus-blast-radius-check would otherwise lose
# --allow-unbuilt and start demanding the whole shipping set.
#
# repository-lock-check is deliberately NOT here. It verifies release pins (which
# external repository commit each vendored mirror was cut from), which only bind
# on `main`; on every other branch the vendored source is meant to run ahead of
# the lock, so running it in lint just demands a lock refresh after each edit
# under src/core|modules/**. The c-repository-pins workflow runs it for `main`
# and for PRs into `main`.
LINT_CHECKS = module-placement-check provider-seams-check subject-corpus-check native-tool-parity-check guidance-tool-parity-check optional-tool-ownership-check module-source-ownership-check module-bus-boundary-check cleanup-ledger-check inc-check line-check curator-sidecar-parse-check schema-sync-check charter-tables-check tier-deps-check module-boundary-check module-inventory-check db2-contract-check db3-contract-check db2-declaration-ledger-check db2-activation-check background-skill-curator-absence-check capability-ownership-check panel-contract-boundary-check published-compose-images-check dispatch-caps-check kb-v1-coverage-check kb-target-isolation-check kb-container-packaging-check deploy-env-consumed-check sidecar-clients-check docs-check docs-gen-check api-conformance-check server-api-conformance-check v1-method-coverage-check cli-v1-routes-check manifest-emitter-linkage-check argspec-numeric-parity-check async-op-handlers-check v1-route-order-check cli-help-coverage-check kb-intelligence-surfaced-check curator-story-check aimee-home-check code-vector-graph-corpus-check proposal-links-check pending-audit-manifest-check proposal-reconcile-check dev-accept-check git-cred-centralized-check sanitizer-callsites-check lessons-isolation-check md-store-retired-check models-dev-snapshot-check test-tmpdir-check tests-are-run-check model-fallback-shadow-check p1-tenant-guard-check bus-blast-radius-check entrypoint-exit-report-check webchat-bootstrap-login-check config-encapsulation-check deployed-image-check

lint:
	@fail=""; n=0; \
	for c in $(LINT_CHECKS); do \
	  n=$$((n+1)); \
	  $(MAKE) --no-print-directory BUS_BLAST_RADIUS_FLAGS='$(BUS_BLAST_RADIUS_FLAGS)' "$$c" \
	    || fail="$$fail $$c"; \
	done; \
	if [ -n "$$fail" ]; then \
	  echo; \
	  echo "lint: FAILED —$$fail"; \
	  echo "lint: all $$n checks ran; fix every one listed, not just the first."; \
	  exit 1; \
	fi; \
	echo "lint: all $$n checks passed"

