      "id": "portable-search",
      "disposition": "portable-now",
      "db3_operation_family": "candidate-search",
      "rationale": "The logical operation accepts a bounded vector and filters DB3 v1 can carry -- workspace, project, record_type -- and returns only opaque candidate IDs and scores; DB2 must rehydrate and authorize every hit.",
      "symbols": [
        "pgvec_code_search",
