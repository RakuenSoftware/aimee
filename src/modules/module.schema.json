{
  "$comment": "Generated by validate_module_descriptors.py; semantic policy is authoritative there.",
  "$id": "https://aimee.local/schemas/module-descriptor-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "c_build": {
      "additionalProperties": false,
      "properties": {
        "compile_definitions": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "include_roots": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "pkg_config": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "system_libraries": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "vendor_sources": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "include_roots",
        "pkg_config",
        "system_libraries"
      ],
      "type": "object"
    },
    "contracts": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "dependencies": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "descriptor_version": {
      "const": 1
    },
    "docs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "enabled_by_default": {
      "type": "boolean"
    },
    "go_sources": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "go_tests": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "ownership_complete": {
      "type": "boolean"
    },
    "private_headers": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "public_headers": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "runtime_toggle": {
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "boolean"
        }
      },
      "required": [
        "supported"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "dependencies",
    "descriptor_version",
    "id",
    "runtime_toggle"
  ],
  "type": "object"
}
