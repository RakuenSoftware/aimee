# Install as /etc/aimee/status-authority.env, owned by root with mode 0600.
AIMEE_KB_STATUS_DSN=postgresql://aimee_kb_status_login:replace@primary/aimee
AIMEE_KB_STATUS_BIND=0.0.0.0
AIMEE_KB_STATUS_PORT=8444
AIMEE_KB_STATUS_TLS_CA=/etc/aimee/status-authority/client-ca.pem
AIMEE_KB_STATUS_TLS_CERT=/etc/aimee/status-authority/server-chain.pem
AIMEE_KB_STATUS_TLS_KEY=/etc/aimee/status-authority/server-key.pem
AIMEE_VAULT_KMS_HELPER=/usr/libexec/aimee/aimee-kms-helper
AIMEE_VAULT_KMS_KEY_ID=replace-with-fixed-status-custody-id
AIMEE_VAULT_KMS_HWM_PUBKEY=/etc/aimee/status-authority/hwm-public.pem
AIMEE_VAULT_KMS_HWM_DOMAIN=replace-with-fixed-hwm-domain
