[Unit]
Description=Aimee Webchat Server
After=network.target

[Service]
Type=simple
User=root
Environment=HOME=/root
# Trusted-proxy secret so the OpenAI proxy stamps trusted X-Aimee-Principal/Source
# metadata that aimee-server honours. `aimee webchat enable` provisions this
# automatically (a drop-in EnvironmentFile, plus the matching
# ingress_trusted_proxy_secret in aimee config). Set it manually otherwise:
#   Environment=AIMEE_INGRESS_PROXY_SECRET=<shared-secret>
ExecStart=/usr/local/bin/aimee-webchat --port 8080
WorkingDirectory=/root/aimee
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
