+const char *agent_scope_name(agent_scope_t s)
+{
+   switch (s)
+   {
+   case AGENT_SCOPE_BOUNDED:
+      return "bounded";
+   case AGENT_SCOPE_WHOLE_TASK:
+      return "whole_task";
+   default:
+      return "";
