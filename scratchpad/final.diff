+         ctx = cap.context_window;
+      /* MiniMax-M3 (1M) is the only seat here that holds 300k. */
+      assert(ctx >= 300000);
+      assert(strcmp(r_on->name, "MiniMax-M3") == 0);
+   }
+
+   printf("  PASS: test_capability_routing_flag_behaviour_diff\n");
+}
